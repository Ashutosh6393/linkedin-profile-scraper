# Copy to .env and fill in. NEVER commit the real .env.
# Both values come from your browser cookies on linkedin.com while logged in.
# DevTools -> Application -> Cookies -> https://www.linkedin.com

# The session cookie. This is the one that actually authenticates you.
LINKEDIN_LI_AT=

# Copy the JSESSIONID value. Paste it without the surrounding quotes.
# It doubles as the csrf-token header.
LINKEDIN_JSESSIONID=
